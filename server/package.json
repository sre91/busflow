{
  "name": "server",
  "version": "1.0.0",
  "description": "BusFlow backend server",
  "type": "module",
  "scripts": {
    "dev": "nodemon --watch src --exec tsx src/server.ts",
    "seed:buses": "tsx src/seed/busSeed.ts",
    "seed:seats": "tsx src/seed/seatSeed.ts",
    "build": "tsc",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "mongoose": "^9.9.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "nodemon": "^3.1.14",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  }
}
